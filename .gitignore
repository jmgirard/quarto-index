cairn/references/sources/
cairn/.merge-approved
cairn/.merge-approved.pending

# Render artifacts
examples/*.tex
examples/*.pdf
examples/*.html
examples/*.md
examples/*.epub
examples/*_files/
# The LaTeX aux family. examples/principal.qmd and examples/principal-cases.qmd
# deliberately keep their `.ind`, `.ilg` and `.aux` (latex-clean: false),
# because the suite reads the first two for the emitted encapsulation and the
# `.aux` for the typeset-time registry that carries the principal role; and a
# FAILED pdf render leaves this family behind for any fixture.
examples/*.aux
examples/*.idx
examples/*.ilg
examples/*.ind
examples/*.log
examples/.quarto/
# The book fixtures render into their own project output directory, and their
# per-chapter store lives in Quarto's own scratch directory.
examples/book*/_book/
examples/book*/.quarto/
/.quarto/
# The docs website renders into its own output directory; site/.gitignore is
# Quarto's own, and covers the project scratch directory beside it.
site/_site/
# The example gallery is built by the site's pre-render step: the fixture
# copies and their renders in a scratch tree at the repo root, and the gallery
# pages and rendered fixtures it places under site/gallery/.
/.gallery-build/
site/gallery/
tests/.work/
